{
  "name": "atmavictu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"build/src/*.test.js\"",
    "atma": "node build/src/atmaCli.js",
    "atma:help": "node build/src/atmaCli.js help",
    "atma:walk": "node build/src/atmaCli.js walk",
    "atma:verify": "node build/src/atmaCli.js verify",
    "atma:exe:preveri": "node atma/preveri-atma-exe.cjs",
    "atma:exe:zgradi": "atma\\zgradi-atma-exe.cmd",
    "atma:bundel": "node atma/zgradi-bundel.cjs",
    "atma:debeli:zgradi": "atma\\zgradi-debeli.cmd",
    "atma:pulz": "node atma/pulz.cjs",
    "atma:besede": "node atma/besede.cjs",
    "proof:capture": "tsc && node build/src/captureIncomingTextProof.js",
    "serve": "tsc && node build/src/workbenchApiServer.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
